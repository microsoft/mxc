{
  "_comment": "Cooperative public proxy with MXC process.env configuration. Replace 203.0.113.10 with the permitted public proxy address before use; public proxy addresses are not supported by runtimeConfig.networkProxy.",
  "version": "0.8.0-alpha",
  "containerId": "ProcessContainerPublicProxy",
  "containment": "processcontainer",
  "process": {
    "commandLine": "curl.exe --fail --show-error --silent https://www.example.com/",
    "env": [
      "HTTP_PROXY=http://203.0.113.10:8080",
      "HTTPS_PROXY=http://203.0.113.10:8080"
    ],
    "timeout": 30000
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "203.0.113.10/32"
            }
          ],
          "ports": [
            {
              "protocol": "tcp",
              "port": 8080
            }
          ]
        }
      ]
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  }
}
