{
  "_comment": "Public direct-egress client limited to one documentation IP and TCP port. Replace 203.0.113.10 with the permitted public destination before use; the TEST-NET-3 address is not routable.",
  "version": "0.8.0-alpha",
  "containerId": "ProcessContainerPublicClient",
  "containment": "processcontainer",
  "process": {
    "commandLine": "curl.exe --fail --show-error --silent https://203.0.113.10/",
    "timeout": 15000
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "203.0.113.10/32"
            }
          ],
          "ports": [
            {
              "protocol": "tcp",
              "port": 443
            }
          ]
        }
      ]
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  }
}
