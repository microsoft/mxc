<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) Microsoft Corporation. All rights reserved.

  WiX v5 installer for the IsolationSession (v4) service.
  Supports side-by-side monthly releases with in-month patching, built
  separately per architecture (x64 or arm64 — never x86).

  Each month gets a unique UpgradeCode (computed by makeinstaller.ps1), so
  different months install side-by-side. x64 and arm64 builds preserve the
  same MonthId-based service, registry, and install-path identity expected by
  the OS runtime. Within a month, MajorUpgrade replaces the previous patch.

  This MSI is normally consumed by the IsoSession bootstrapper bundle
  (IsoSessionBundle.wxs), which wraps it in a UI EXE. It can still be installed
  directly with msiexec for automation.

  Variables (passed by makeinstaller.ps1 via DefineConstants):
    $(var.BinDir)       - Build output directory containing the IsoSession
                          binaries for the target architecture
    $(var.InstallerDir) - This installer subtree's own directory (source for
                          the locally maintained CLI manifest)
    $(var.Version)      - MSI version (YY.M.Patch.0)
    $(var.UpgradeCode)  - Per-month GUID (deterministic from MonthId)
    $(var.AppId)        - Per-month COM AppID (deterministic, enables true SxS)
    $(var.ClientClsid)  - Per-month CLSID for ComSessionClient
    $(var.ProxyConnectionClsid) - Per-month CLSID for ComSessionProxyConnection
    $(var.MonthId)      - Release month (e.g., "2026.06")
    $(var.Arch)         - Target architecture ("x64" or "arm64")
    $(var.ServiceName)  - Versioned service name (e.g., "IsolationSession_2026_06")
    $(var.InstallSubDir)- Relative install path (e.g., "Microsoft\Agentic Runtime\2026.06")

  Usage (direct):
    msiexec /i IsoSession_2026_06_x64.msi /qn
    msiexec /x IsoSession_2026_06_x64.msi /qn
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Per-month SxS values (Version, UpgradeCode, AppId, CLSIDs,
       ServiceName, InstallSubDir, BinDir, InstallerDir, MonthId, Arch) come
       from a generated include whose path is passed via the single
       'IsoSessionVars' define. makeinstaller.ps1 writes one for each build. -->
  <?include $(var.IsoSessionVars) ?>

  <?define ProductName = "IsolationSession Service $(var.MonthId) ($(var.Arch)) (Dev)" ?>
  <?define Manufacturer = "Microsoft Corporation" ?>

  <!-- COM GUIDs — per-month CLSIDs generated by makeinstaller.ps1 (UUID v5) -->
  <!-- Proxy stub CLSID is shared (same binary identity string on all months/archs) -->
  <?define CLSID_IsoSessionProxyStub = "{2B526D49-56AC-4D72-8692-4DB1F4EDFA7C}" ?>

  <!-- Interface IIDs -->
  <?define IID_IComSessionClient = "{BE6C975A-BFED-4338-BC4D-600CF83614CE}" ?>
  <?define IID_IComSessionOperationCallback = "{9A7B80F0-7644-47BB-B884-5B0A4331E517}" ?>
  <?define IID_IComSessionProvisionCallback = "{E3B33D6A-572A-4515-8113-BB66BC6730B4}" ?>
  <?define IID_IComSessionProxyCallback = "{9946C1AC-7F31-4BB6-8AD2-59D75FC490A2}" ?>
  <?define IID_IComSessionProxyConnection = "{AAB45130-236A-4A0D-8BA4-FE68A79B7A85}" ?>
  <?define IID_IComSessionProxySessionCallback = "{63711C2F-7030-4C37-8363-EC9F78EA8B7F}" ?>
  <?define IID_IComSessionRegistrationCallback = "{3A088D05-29B4-4A53-BC5C-5BEA8E6A6231}" ?>
  <?define IID_IComSessionUtilityLogonCallback = "{E7E5FBD4-4258-4A79-9FC3-24FC40C59531}" ?>
  <?define IID_IComSessionUtilityLogonConnection = "{291CAFAA-73F3-4912-9579-4DCC4B09E502}" ?>
  <?define IID_IComSessionWorkerProcess = "{DD8D5731-929C-4C56-B178-1408054EB70F}" ?>
  <?define IID_IComSessionWorkerProcessCallback = "{FA560CC0-DC0B-4E83-ABD1-D4E0DAA145EC}" ?>
  <?define IID_IComStationWatcherCallback = "{3F44A898-9856-46E1-B029-4A5FACE5ABA1}" ?>
  <?define IID_IComSubordinateCallback = "{FB202185-9A56-4849-BFD1-47E324A9F8AA}" ?>
  <?define IID_IComTaskWatcherCallback = "{0F4D3D19-5A11-4C65-A777-7DA7E1810290}" ?>

  <!-- WiX v5 merges Product+Package into a single Package element. ProductCode
       is auto-generated ("*") on each build. Architecture (x64 or arm64) comes
       from the project's Platform property (-p:Platform=$(var.Arch)), which
       also makes components and registry writes native-bitness by default. -->
  <Package Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation
        Description="IsolationSession v4 service ($(var.MonthId), $(var.Arch)) for dev/test VMs" />

    <!-- In-month patching: same UpgradeCode + higher version triggers replacement -->
    <MajorUpgrade DowngradeErrorMessage=
        "A newer patch for $(var.MonthId) ($(var.Arch)) is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- ================================================================ -->
    <!-- Directory layout — versioned under Program Files                  -->
    <!-- ProgramFiles64Folder is the native (non-WOW64) Program Files      -->
    <!-- folder on BOTH x64 and arm64 systems — there is no separate       -->
    <!-- "Program Files (Arm)" folder, so this StandardDirectory Id is     -->
    <!-- already architecture-safe and requires no per-arch branching.     -->
    <!-- Keep the MonthId-only path used by IsoSessionVersionPath.h.       -->
    <!-- ================================================================ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="Dir_Microsoft" Name="Microsoft">
        <Directory Id="Dir_AgenticRuntime" Name="Agentic Runtime">
          <Directory Id="INSTALLDIR" Name="$(var.MonthId)" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- ================================================================ -->
    <!-- Binary components                                                 -->
    <!-- ================================================================ -->
    <DirectoryRef Id="INSTALLDIR">

      <Component Id="Comp_IsoSessionServer">
        <File Id="IsoSessionServer.dll"
              Source="$(var.BinDir)\IsoSessionServer.dll"
              KeyPath="yes" />
      </Component>

      <Component Id="Comp_IsoSessionCore">
        <File Id="IsoSessionCore.dll"
              Source="$(var.BinDir)\IsoSessionCore.dll"
              KeyPath="yes" />
      </Component>

      <Component Id="Comp_IsoSessionClient">
        <File Id="IsoSessionClient.dll"
              Source="$(var.BinDir)\IsoSessionClient.dll"
              KeyPath="yes" />
      </Component>

      <Component Id="Comp_IsoSessionApp">
        <File Id="IsoSessionApp.dll"
              Source="$(var.BinDir)\IsoSessionApp.dll"
              KeyPath="yes" />
      </Component>

      <Component Id="Comp_IsoSessionProxyStub">
        <File Id="IsoSessionProxyStub.dll"
              Source="$(var.BinDir)\IsoSessionProxyStub.dll"
              KeyPath="yes" />
      </Component>

      <Component Id="Comp_IsoSessionCli">
        <File Id="IsoSessionCli.exe"
              Source="$(var.BinDir)\IsoSessionCli.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="Comp_IsoSessionCliManifest">
        <File Id="IsoSessionCli.exe.manifest"
              Name="IsoSessionCli.exe.manifest"
              Source="$(var.InstallerDir)\IsoSessionCli.exe.manifest"
              KeyPath="yes" />
      </Component>

      <Component Id="Comp_IsoSessionManifest">
        <File Id="IsoSession.manifest"
              Name="IsoSession.manifest"
              Source="$(var.RuntimeManifestPath)"
              KeyPath="yes" />
      </Component>

      <Component Id="Comp_IsolationProxy">
        <File Id="IsolationProxy.exe"
              Source="$(var.BinDir)\IsolationProxy.exe"
              KeyPath="yes" />
      </Component>

    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- Service installation — versioned service name                     -->
    <!-- Each monthly release runs as its own svchost service instance.    -->
    <!-- service instance. Uses sc.exe via CustomAction so SCM picks up    -->
    <!-- the service immediately (direct registry writes require reboot).  -->
    <!-- ================================================================ -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Comp_Service">

        <!-- Service Parameters — ServiceDll points to versioned install dir -->
        <!-- (read by svchost at service start, not by SCM) -->
        <RegistryKey Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\$(var.ServiceName)\Parameters"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="expandable" Name="ServiceDll"
                         Value="[INSTALLDIR]IsoSessionServer.dll" />
          <RegistryValue Type="string" Name="ServiceMain" Value="ServiceMain" />
          <RegistryValue Type="integer" Name="ServiceDllUnloadOnStop" Value="0" />
          <RegistryValue Type="string" Name="ClientClsid"
                         Value="$(var.ClientClsid)" />
          <RegistryValue Type="string" Name="ProxyConnectionClsid"
                         Value="$(var.ProxyConnectionClsid)" />
        </RegistryKey>

        <!-- Svchost group registration (versioned group name) -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\SvcHost"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="multiString" Name="$(var.ServiceName)"
                         Value="$(var.ServiceName)" />
        </RegistryKey>

        <!-- Svchost group settings -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\SvcHost\$(var.ServiceName)"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="integer" Name="CoInitializeSecurityParam" Value="1" />
          <RegistryValue Type="integer" Name="COM_RoSettings" Value="792" />
        </RegistryKey>

        <RegistryValue Root="HKLM"
                       Key="SYSTEM\CurrentControlSet\Services\$(var.ServiceName)"
                       Name="AllowTestSignedProxy" Type="integer" Value="1" />

        <RegistryValue Root="HKLM"
                       Key="SYSTEM\CurrentControlSet\Services\$(var.ServiceName)"
                       Name="_MsiServiceMarker" Type="string" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- Service CustomActions — use sc.exe so SCM is updated immediately  -->
    <!-- The Util extension's quiet-exec CA binary is architecture-        -->
    <!-- specific (Wix4UtilCA_X64 / Wix4UtilCA_A64). The                   -->
    <!-- $(sys.BUILDARCHSHORT) preprocessor variable resolves to the       -->
    <!-- correct suffix for whichever Platform (x64/arm64) this project is -->
    <!-- built for, so the same authoring works for both architectures     -->
    <!-- without per-arch WXS branching. DllEntry is the architecture-     -->
    <!-- neutral "WixQuietExec" (not the "...64" variant, which is only    -->
    <!-- for calling a 64-bit process from a 32-bit package — not our      -->
    <!-- case, since we build natively for x64/arm64).                     -->
    <!-- ================================================================ -->
    <SetProperty Id="CA_CreateService" Before="CA_CreateService" Sequence="execute"
                 Value="&quot;[System64Folder]sc.exe&quot; create $(var.ServiceName) type= own start= demand binPath= &quot;%SystemRoot%\system32\svchost.exe -k $(var.ServiceName) -p&quot; obj= LocalSystem depend= RpcSs/ProfSvc/CryptSvc DisplayName= &quot;IsolationSession ($(var.MonthId), $(var.Arch))&quot;" />

    <SetProperty Id="CA_SetServiceSid" Before="CA_SetServiceSid" Sequence="execute"
                 Value="&quot;[System64Folder]sc.exe&quot; sidtype $(var.ServiceName) unrestricted" />

    <SetProperty Id="CA_StopService" Before="CA_StopService" Sequence="execute"
                 Value="&quot;[System64Folder]sc.exe&quot; stop $(var.ServiceName)" />

    <SetProperty Id="CA_DeleteService" Before="CA_DeleteService" Sequence="execute"
                 Value="&quot;[System64Folder]sc.exe&quot; delete $(var.ServiceName)" />

    <CustomAction Id="CA_CreateService" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec" Execute="deferred"
                  Impersonate="no" Return="check" />

    <CustomAction Id="CA_SetServiceSid" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec" Execute="deferred"
                  Impersonate="no" Return="check" />

    <CustomAction Id="CA_StopService" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec" Execute="deferred"
                  Impersonate="no" Return="ignore" />

    <CustomAction Id="CA_DeleteService" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec" Execute="deferred"
                  Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CA_CreateService" After="InstallFiles"
              Condition="NOT Installed AND NOT REMOVE" />
      <Custom Action="CA_SetServiceSid" After="CA_CreateService"
              Condition="NOT Installed AND NOT REMOVE" />
      <Custom Action="CA_StopService" Before="CA_DeleteService"
              Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="CA_DeleteService" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- ================================================================ -->
    <!-- COM AppID registration — versioned to point to monthly service    -->
    <!-- ================================================================ -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Comp_ComAppId">
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\AppID\$(var.AppId)"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Name="LocalService"
                         Value="$(var.ServiceName)" />
        </RegistryKey>

        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Classes\AppID\$(var.AppId)"
                       Name="_MsiAppIdMarker" Type="string" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- COM CLSID registration                                            -->
    <!-- Maps CLSIDs to the AppID so COM launches the versioned service    -->
    <!-- ================================================================ -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Comp_Clsid_ComSessionClient">
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\CLSID\$(var.ClientClsid)"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Name="AppID" Value="$(var.AppId)" />
        </RegistryKey>

        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Classes\CLSID\$(var.ClientClsid)"
                       Name="_MsiClsidMarker" Type="string" Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="Comp_Clsid_ComSessionProxyConn">
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\CLSID\$(var.ProxyConnectionClsid)"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Name="AppID" Value="$(var.AppId)" />
        </RegistryKey>

        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Classes\CLSID\$(var.ProxyConnectionClsid)"
                       Name="_MsiClsidMarker" Type="string" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- Proxy-stub CLSID registration (InprocServer32)                    -->
    <!-- Points to versioned install path for the proxy stub DLL           -->
    <!-- ================================================================ -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Comp_ProxyStub_Clsid">
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\CLSID\$(var.CLSID_IsoSessionProxyStub)\InprocServer32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="[INSTALLDIR]IsoSessionProxyStub.dll" />
          <RegistryValue Type="string" Name="ThreadingModel" Value="Both" />
        </RegistryKey>

        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Classes\CLSID\$(var.CLSID_IsoSessionProxyStub)"
                       Name="_MsiPsMarker" Type="string" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- Interface proxy-stub registration                                 -->
    <!-- Points each interface IID to the proxy-stub CLSID                 -->
    <!-- ================================================================ -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Comp_Interface_ProxyStub">

        <!-- IComSessionClient -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionClient)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionProxyConnection -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionProxyConnection)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionWorkerProcess -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionWorkerProcess)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionOperationCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionOperationCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionProvisionCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionProvisionCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionProxyCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionProxyCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionProxySessionCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionProxySessionCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionRegistrationCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionRegistrationCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionWorkerProcessCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionWorkerProcessCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionUtilityLogonCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionUtilityLogonCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSessionUtilityLogonConnection -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionUtilityLogonConnection)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComTaskWatcherCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComTaskWatcherCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComStationWatcherCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComStationWatcherCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <!-- IComSubordinateCallback -->
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\Classes\Interface\$(var.IID_IComSubordinateCallback)\ProxyStubClsid32"
                     ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Value="$(var.CLSID_IsoSessionProxyStub)" />
        </RegistryKey>

        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Classes\Interface\$(var.IID_IComSessionClient)"
                       Name="_MsiIfaceMarker" Type="string" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- Install-location record                                           -->
    <!-- Records the actual install dir so version resolution works at a   -->
    <!-- custom (non-default) INSTALLDIR. Read by                          -->
    <!-- IsoSession::Activation::ResolveInstallDir (IsoSessionVersionPath.h)-->
    <!-- keyed by the underscore runtime token. [INSTALLDIR] resolves to   -->
    <!-- the chosen path with a trailing backslash; the resolver trims it. -->
    <!-- ================================================================ -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Comp_InstallDirRecord">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\IsoSession\$(var.RuntimeToken)"
                       Name="InstallDir" Type="string" Value="[INSTALLDIR]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ================================================================ -->
    <!-- Feature definition                                                -->
    <!-- ================================================================ -->
    <Feature Id="Complete" Title="IsolationSession Service ($(var.MonthId), $(var.Arch))" Level="1">
      <ComponentRef Id="Comp_IsoSessionServer" />
      <ComponentRef Id="Comp_IsoSessionCore" />
      <ComponentRef Id="Comp_IsoSessionClient" />
      <ComponentRef Id="Comp_IsoSessionApp" />
      <ComponentRef Id="Comp_IsoSessionProxyStub" />
      <ComponentRef Id="Comp_IsoSessionCli" />
      <ComponentRef Id="Comp_IsoSessionCliManifest" />
      <ComponentRef Id="Comp_IsoSessionManifest" />
      <ComponentRef Id="Comp_IsolationProxy" />
      <ComponentRef Id="Comp_Service" />
      <ComponentRef Id="Comp_ComAppId" />
      <ComponentRef Id="Comp_Clsid_ComSessionClient" />
      <ComponentRef Id="Comp_Clsid_ComSessionProxyConn" />
      <ComponentRef Id="Comp_ProxyStub_Clsid" />
      <ComponentRef Id="Comp_Interface_ProxyStub" />
      <ComponentRef Id="Comp_InstallDirRecord" />
    </Feature>

  </Package>
</Wix>
