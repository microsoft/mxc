{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/microsoft/mxc/schemas/dev/mxc-config.schema.0.8.0-dev.json",
  "title": "MXC Configuration",
  "description": "MXC container execution configuration. Defines the recommended config format\nfor both one-shot and state-aware sandbox lifecycle requests. A few\ndeprecated field spellings not listed here are also accepted via serde aliases.",
  "additionalProperties": false,
  "definitions": {
    "BaseProcessUi": {
      "additionalProperties": false,
      "description": "BaseProcessContainer UI isolation settings.",
      "properties": {
        "desktopSystemControl": {
          "description": "Whether desktop system control is allowed.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "ime": {
          "description": "Whether the IME (Input Method Editor) is allowed.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "isolation": {
          "anyOf": [
            {
              "$ref": "#/definitions/UiIsolation"
            },
            {
              "type": "null"
            }
          ],
          "description": "UI isolation level."
        },
        "systemSettings": {
          "description": "System settings access level.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CaptureDenials": {
      "additionalProperties": false,
      "description": "Windows denial-capture settings. The presence of the `captureDenials`\nobject enables capture; all fields are optional.",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "$ref": "#/definitions/CaptureDenialsMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "How each ungranted access check is handled while it is recorded. Both\nmodes log every access the policy does not grant to the ETL trace; the\nmode only decides whether that access is blocked or allowed. Defaults to\n`block` when omitted."
        },
        "outputPath": {
          "description": "Absolute path where the denial ETL trace is written. The caller names\nthe path; the OS opens it under the caller's own identity when the trace\nis sealed. When omitted, MXC writes the trace to a managed per-run\ntemporary file. The parent directory must already exist.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CaptureDenialsMode": {
      "description": "How `captureDenials` handles each ungranted access check while recording it.",
      "oneOf": [
        {
          "const": "block",
          "description": "`block` — the access stays **denied** and the denial is recorded.\nDeny-by-default containment is preserved; this is the safe default.",
          "type": "string"
        },
        {
          "const": "allow",
          "description": "`allow` — the access is **allowed** and recorded (audit mode).\nThis relaxes deny-by-default for the run, so it is a security-sensitive\nchoice and the runner emits a security warning.",
          "type": "string"
        }
      ]
    },
    "ClipboardPolicy": {
      "description": "Clipboard access level.",
      "enum": [
        "none",
        "read",
        "write",
        "all"
      ],
      "type": "string"
    },
    "Containment": {
      "description": "Containment backend (abstract intent or concrete backend).",
      "oneOf": [
        {
          "const": "process",
          "description": "OS-native process sandbox (resolved per host).",
          "type": "string"
        },
        {
          "const": "processcontainer",
          "description": "Windows AppContainer / BaseContainer.",
          "type": "string"
        },
        {
          "const": "vm",
          "description": "VM-class isolation (resolved per host).",
          "type": "string"
        },
        {
          "const": "windows_sandbox",
          "description": "Windows Sandbox (experimental).",
          "type": "string"
        },
        {
          "const": "lxc",
          "description": "Full Linux container.",
          "type": "string"
        },
        {
          "const": "microvm",
          "description": "NanVix micro-VM (experimental).",
          "type": "string"
        },
        {
          "const": "hyperlight",
          "description": "Hyperlight micro-VM (experimental).",
          "type": "string"
        },
        {
          "const": "wslc",
          "description": "WSL container (experimental).",
          "type": "string"
        },
        {
          "const": "seatbelt",
          "description": "macOS Seatbelt.",
          "type": "string"
        },
        {
          "const": "isolation_session",
          "description": "Windows IsolationSession (experimental).",
          "type": "string"
        },
        {
          "const": "bubblewrap",
          "description": "Unprivileged Linux bubblewrap sandbox.",
          "type": "string"
        }
      ]
    },
    "Experimental": {
      "description": "Experimental features (only honored with `--experimental`). This block is\nintentionally **permissive** (no `deny_unknown_fields`): experimental\nbackends are in flux, so the schema documents the known shapes for editor\nhelp without rejecting in-progress fields. The strict, closed contract is\nthe stable (top-level) surface.",
      "properties": {
        "isolation_session": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationSession"
            },
            {
              "type": "null"
            }
          ],
          "description": "IsolationSession backend config (Windows)."
        },
        "seatbelt": {
          "anyOf": [
            {
              "$ref": "#/definitions/Seatbelt"
            },
            {
              "type": "null"
            }
          ],
          "description": "Seatbelt backend config (pre-promotion alias)."
        },
        "telemetry": {
          "anyOf": [
            {
              "$ref": "#/definitions/Telemetry"
            },
            {
              "type": "null"
            }
          ],
          "description": "Telemetry configuration."
        },
        "test": {
          "anyOf": [
            {
              "$ref": "#/definitions/TestFeature"
            },
            {
              "type": "null"
            }
          ],
          "description": "Placeholder feature for testing experimental infrastructure."
        },
        "windows_sandbox": {
          "anyOf": [
            {
              "$ref": "#/definitions/WindowsSandbox"
            },
            {
              "type": "null"
            }
          ],
          "description": "Windows Sandbox backend config."
        },
        "wslc": {
          "anyOf": [
            {
              "$ref": "#/definitions/Wslc"
            },
            {
              "type": "null"
            }
          ],
          "description": "WSL container backend config."
        }
      },
      "type": "object"
    },
    "Fallback": {
      "additionalProperties": false,
      "description": "AppContainer DACL-mutation fallback policy.",
      "properties": {
        "allowDaclMutation": {
          "description": "Allow the runner to mutate DACLs as a fallback.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Filesystem": {
      "additionalProperties": false,
      "description": "Filesystem access policy.",
      "properties": {
        "deniedPaths": {
          "description": "Paths explicitly denied (override broader allow rules).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "readonlyPaths": {
          "description": "Paths the process can read but not write.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "readwritePaths": {
          "description": "Paths the process can read and write.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "IsolationConfigurationId": {
      "description": "IsolationSession sizing profile.",
      "enum": [
        "small",
        "medium",
        "large",
        "composable"
      ],
      "type": "string"
    },
    "IsolationSession": {
      "description": "IsolationSession backend config. Carries both the one-shot fields\n(`configurationId`, `user`) and the per-phase state-aware nesting\n(`provision` / `start` / `stop` / `deprovision`).",
      "properties": {
        "configurationId": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationConfigurationId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sizing profile (one-shot)."
        },
        "deprovision": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationSessionPhase"
            },
            {
              "type": "null"
            }
          ],
          "description": "State-aware deprovision-phase configuration."
        },
        "provision": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationSessionPhase"
            },
            {
              "type": "null"
            }
          ],
          "description": "State-aware provision-phase configuration."
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationSessionPhase"
            },
            {
              "type": "null"
            }
          ],
          "description": "State-aware start-phase configuration."
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationSessionPhase"
            },
            {
              "type": "null"
            }
          ],
          "description": "State-aware stop-phase configuration."
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationUser"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional Entra cloud-agent user bundle (one-shot)."
        }
      },
      "type": "object"
    },
    "IsolationSessionPhase": {
      "description": "Per-phase IsolationSession configuration (state-aware lifecycle).",
      "properties": {
        "configurationId": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationConfigurationId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sizing profile for this phase."
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/definitions/IsolationUser"
            },
            {
              "type": "null"
            }
          ],
          "description": "Entra cloud-agent user bundle for this phase."
        }
      },
      "type": "object"
    },
    "IsolationUser": {
      "description": "Entra cloud-agent user bundle. Reachable only under the permissive\n`experimental` surface, so unknown fields are tolerated (forward-compat).",
      "properties": {
        "upn": {
          "description": "User principal name.",
          "type": "string"
        },
        "wamToken": {
          "description": "Short-lived WAM bearer token (passed verbatim to the OS service).",
          "type": "string"
        }
      },
      "required": [
        "upn",
        "wamToken"
      ],
      "type": "object"
    },
    "LaunchMethod": {
      "description": "Seatbelt inner-process launch method.",
      "oneOf": [
        {
          "const": "exec",
          "description": "sandbox_init() + exec (default). Works for third-party GUI apps.",
          "type": "string"
        },
        {
          "const": "open",
          "description": "Launch via macOS LaunchServices (`open`), then apply the sandbox to the\ninner shell via sandbox-exec. Required for apps with launch constraints.",
          "type": "string"
        }
      ]
    },
    "Lifecycle": {
      "additionalProperties": false,
      "description": "Container lifecycle settings.",
      "properties": {
        "destroyOnExit": {
          "description": "Destroy the container when the process exits (default true).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "preservePolicy": {
          "description": "Preserve the applied policy after exit (default false).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Lxc": {
      "additionalProperties": false,
      "description": "LXC container settings.",
      "properties": {
        "distribution": {
          "description": "Distribution image (e.g. `alpine`).",
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "description": "Distribution release (e.g. `3.23`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "description": "Network access policy.",
      "properties": {
        "allowLocalNetwork": {
          "description": "Allow binding/listening on local IPs and accepting inbound connections.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowedHosts": {
          "description": "Hosts explicitly allowed.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "blockedHosts": {
          "description": "Hosts explicitly blocked.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "defaultPolicy": {
          "anyOf": [
            {
              "$ref": "#/definitions/NetworkPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Default outbound policy when no host rule matches."
        },
        "enforcementMode": {
          "anyOf": [
            {
              "$ref": "#/definitions/NetworkEnforcement"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the policy is enforced."
        },
        "proxy": {
          "anyOf": [
            {
              "$ref": "#/definitions/Proxy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Proxy configuration (one of localhost / builtinTestServer / url)."
        }
      },
      "type": "object"
    },
    "NetworkEnforcement": {
      "description": "Network enforcement mechanism.",
      "oneOf": [
        {
          "const": "capabilities",
          "description": "Per-process capability-based filtering.",
          "type": "string"
        },
        {
          "const": "firewall",
          "description": "Host firewall rules.",
          "type": "string"
        },
        {
          "const": "both",
          "description": "Both capability and firewall enforcement.",
          "type": "string"
        }
      ]
    },
    "NetworkPolicy": {
      "description": "Default network policy.",
      "enum": [
        "allow",
        "block"
      ],
      "type": "string"
    },
    "Phase": {
      "description": "State-aware lifecycle phase.",
      "enum": [
        "provision",
        "start",
        "exec",
        "stop",
        "deprovision"
      ],
      "type": "string"
    },
    "PortMapping": {
      "description": "A single host → container port forward. Reachable only under the permissive\n`experimental` surface, so unknown fields are tolerated (forward-compat).",
      "properties": {
        "containerPort": {
          "description": "Container port.",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/definitions/TransportProtocol"
            },
            {
              "type": "null"
            }
          ],
          "description": "Transport protocol for the mapping. Only `tcp` is currently supported."
        },
        "windowsPort": {
          "description": "Host (Windows) port.",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "windowsPort",
        "containerPort"
      ],
      "type": "object"
    },
    "Process": {
      "additionalProperties": false,
      "description": "Process execution settings.",
      "properties": {
        "commandLine": {
          "description": "Command line (or script) to execute.",
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "description": "Working directory for the process.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "description": "Environment variables as `\"KEY=VALUE\"` strings.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "timeout": {
          "description": "Wall-clock timeout in milliseconds.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProcessContainer": {
      "additionalProperties": false,
      "description": "ProcessContainer-specific settings.",
      "properties": {
        "capabilities": {
          "description": "AppContainer capabilities (e.g. `internetClient`, `registryRead`).\nEach array entry must contain exactly one capability name; commas are\nrejected because BaseContainer uses commas as its wire delimiter.\n`learningModeLogging` and `permissiveLearningMode` are reserved and\nrejected here; use `learningMode`, `--audit`, or the dedicated denial\ncapture configuration instead.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "captureDenials": {
          "anyOf": [
            {
              "$ref": "#/definitions/CaptureDenials"
            },
            {
              "type": "null"
            }
          ],
          "description": "Windows denial capture. When present, the runner records the sandboxed\nprocess's access attempts to a learning-mode ETL trace for later\ninspection. Requires a host that exposes the learning-mode OS API."
        },
        "learningMode": {
          "description": "AppContainer learning mode (deny-and-record): failed access checks are\nlogged for diagnostics while the accesses stay denied; containment is\nunchanged. Distinct from the allow-all `permissiveLearningMode`\ncapability, which is injected internally by the `--audit` CLI flag or\ndedicated denial-capture configuration.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "leastPrivilege": {
          "description": "Enforce least-privilege mode.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "ui": {
          "anyOf": [
            {
              "$ref": "#/definitions/BaseProcessUi"
            },
            {
              "type": "null"
            }
          ],
          "description": "BaseProcessContainer UI settings (Windows)."
        }
      },
      "type": "object"
    },
    "Proxy": {
      "additionalProperties": false,
      "description": "Proxy configuration. Exactly one variant applies.",
      "properties": {
        "builtinTestServer": {
          "description": "Have wxc launch its own built-in test proxy.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "localhost": {
          "description": "External localhost proxy port.",
          "maximum": 65535,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "description": "Proxy URL (parsed into host:port).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Seatbelt": {
      "additionalProperties": false,
      "description": "macOS Seatbelt backend configuration.",
      "properties": {
        "extraMachLookups": {
          "description": "Additional Mach service global-names the inner process may resolve.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "guiAccess": {
          "description": "Allow GUI (WindowServer) access.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "keychainAccess": {
          "description": "Allow Keychain access.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "launchMethod": {
          "anyOf": [
            {
              "$ref": "#/definitions/LaunchMethod"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inner process launch method."
        },
        "nestedPty": {
          "description": "Attach the inner process to a nested pty (default true).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "profileOverride": {
          "description": "Replace the generated profile entirely (advanced/testing escape hatch).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Telemetry": {
      "description": "Telemetry configuration (`experimental.telemetry`).",
      "properties": {
        "enabled": {
          "description": "Explicit telemetry override. `true` = force on, `false` = force off,\nomitted = disabled (default off).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TestFeature": {
      "description": "Placeholder experimental feature.",
      "properties": {
        "message": {
          "description": "Message to log when the feature is applied.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TransportProtocol": {
      "description": "Port-forward transport protocol. Only `tcp` is currently supported by the\nvendored WSLC SDK runtime; `udp` is rejected at parse time.",
      "enum": [
        "tcp"
      ],
      "type": "string"
    },
    "Ui": {
      "additionalProperties": false,
      "description": "Cross-platform UI isolation policy.",
      "properties": {
        "clipboard": {
          "anyOf": [
            {
              "$ref": "#/definitions/ClipboardPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Clipboard access level."
        },
        "disable": {
          "description": "Disable all UI access (default true).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "injection": {
          "description": "Allow UI injection.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "UiIsolation": {
      "description": "Desktop UI isolation level.",
      "enum": [
        "desktop",
        "handles",
        "atoms",
        "container"
      ],
      "type": "string"
    },
    "WindowsSandbox": {
      "description": "Windows Sandbox backend config.",
      "properties": {
        "daemonPipeName": {
          "description": "Daemon named-pipe override.",
          "type": [
            "string",
            "null"
          ]
        },
        "idleTimeout": {
          "description": "Idle timeout (legacy seconds field).",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "idleTimeoutMs": {
          "description": "Idle timeout before teardown (ms).",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Wslc": {
      "description": "WSL container backend config.",
      "properties": {
        "cpuCount": {
          "description": "vCPU count.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "gpu": {
          "description": "Enable GPU passthrough.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "image": {
          "description": "Container image reference.",
          "type": [
            "string",
            "null"
          ]
        },
        "imageTarPath": {
          "description": "Path to a local image tarball.",
          "type": [
            "string",
            "null"
          ]
        },
        "memoryMb": {
          "description": "Memory limit (MB).",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "portMappings": {
          "description": "Host → container port forwards. Only TCP is currently supported; the\nparser rejects `udp` because the WSLC SDK runtime returns `E_NOTIMPL`\nfor UDP port mappings.",
          "items": {
            "$ref": "#/definitions/PortMapping"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "storagePath": {
          "description": "Storage path override.",
          "type": [
            "string",
            "null"
          ]
        },
        "targetOs": {
          "description": "OS inside the WSL container.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "$schema": {
      "description": "Optional JSON Schema reference for editor validation. Accepted but\nignored by the parser.",
      "type": [
        "string",
        "null"
      ]
    },
    "_comment": {
      "description": "Optional human-readable annotation. Accepted but ignored by the parser."
    },
    "containerId": {
      "description": "Externally assigned container identifier.",
      "type": [
        "string",
        "null"
      ]
    },
    "containment": {
      "anyOf": [
        {
          "$ref": "#/definitions/Containment"
        },
        {
          "type": "null"
        }
      ],
      "description": "Containment backend to use for execution. Accepts abstract intents\n(`process`, `vm`) and concrete backends; the binary resolves intents to\na concrete backend per host at run time."
    },
    "correlationVector": {
      "description": "Microsoft Correlation Vector (MS-CV) seeded at `provision` and returned in\nthe provision result. The client relays it verbatim into every later\nstate-aware phase so all phases of one lifecycle share a telemetry base\nprefix (emitted under `__TlgCV__`). The executor is the trust boundary: on\neach non-provision phase it validates the relayed value and *spins* a fresh\nchild element off a mutable base (so multiple invocations of one phase stay\ndistinct), passes an already-frozen vector through unchanged, and reseeds a\nbrand-new base if the relayed value is absent or malformed — so a missing\nor hostile relay never reaches telemetry unvalidated. Ignored unless\nexperimental telemetry is enabled; not valid on one-shot requests.",
