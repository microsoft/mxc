  "definitions": {
    "CaptureDenials": {
      "additionalProperties": false,
      "description": "Windows denial-capture settings.",
      "properties": {
        "mode": {
          "$ref": "#/definitions/CaptureDenialsMode",
          "description": "How each ungranted access is handled while it is recorded."
        },
        "outputPath": {
          "description": "Optional destination for the generated denial report.",
          "type": "string"
        },
        "retainEtl": {
          "description": "Whether to retain the sealed ETL trace after analysis. Retained traces can contain sensitive resource paths and identifiers; callers are responsible for deleting them.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "CaptureDenialsMode": {
      "oneOf": [
        {
          "description": "Block",
          "enum": [
            "block"
          ],
          "type": "string"
        },
        {
          "description": "Allow",
          "enum": [
            "allow"
          ],
          "type": "string"
        }
      ]
    },
    "Fallback": {
      "additionalProperties": false,
      "description": "Operator consent for containment fallback behavior.",
      "properties": {
        "allowDaclMutation": {
          "description": "Whether the runtime may mutate host filesystem DACLs as a fallback.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Filesystem": {
      "additionalProperties": false,
      "description": "Filesystem access policy.",
      "properties": {
        "deniedPaths": {
          "description": "Optional paths denied access.",
