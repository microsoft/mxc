    "ProcessContainer": {
      "additionalProperties": false,
      "description": "ProcessContainer-specific settings.",
      "properties": {
        "capabilities": {
          "description": "Optional AppContainer capability names. Each entry must contain one name; commas are rejected because BaseContainer uses them as its wire delimiter. `learningModeLogging` and `permissiveLearningMode` are reserved; use `learningMode`, `--audit`, or `captureDenials` instead.",
