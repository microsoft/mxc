          "description": "Optional default action for private-network inbound traffic."
        },
        "hostLoopback": {
          "$ref": "#/definitions/NetworkAction",
          "description": "Optional bidirectional host-loopback connectivity action."
        }
      },
      "type": "object"
    },
    "NetworkPeer": {
      "additionalProperties": false,
      "description": "A CIDR destination, optionally excluding narrower ranges within it.",
