        },
        "ingress": {
          "$ref": "#/definitions/NetworkIngress",
          "description": "Optional inbound and host-loopback network rules."
        }
      },
      "type": "object"
    },
    "NetworkAction": {
      "oneOf": [
        {
          "description": "Allow",
          "enum": [
            "allow"
          ],
          "type": "string"
        },
        {
          "description": "Deny",
          "enum": [
            "deny"
          ],
          "type": "string"
        }
      ]
    },
    "NetworkEgress": {
      "additionalProperties": false,
      "description": "Outbound network policy.",
      "properties": {
        "allow": {
          "description": "Optional explicit allow rules.",
          "items": {
            "$ref": "#/definitions/NetworkRule"
          },
          "type": "array"
        },
        "default": {
          "$ref": "#/definitions/NetworkAction",
          "description": "Optional action applied when no explicit rule matches."
        },
        "deny": {
          "description": "Optional explicit deny rules. Deny takes precedence over allow.",
          "items": {
            "$ref": "#/definitions/NetworkRule"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "NetworkIngress": {
      "additionalProperties": false,
      "description": "Inbound and host-loopback network policy.",
