          "description": "Udp",
          "enum": [
            "udp"
          ],
          "type": "string"
        },
        {
          "description": "Icmp",
          "enum": [
            "icmp"
          ],
          "type": "string"
        },
        {
          "description": "Any",
          "enum": [
            "any"
          ],
          "type": "string"
        }
      ]
    },
    "NetworkRule": {
      "additionalProperties": false,
      "description": "One outbound rule, matching destinations and ports.",
      "properties": {
        "ports": {
          "description": "Optional destination protocols and ports. Omission matches all.",
          "items": {
            "$ref": "#/definitions/NetworkPort"
          },
          "minItems": 1,
          "type": "array"
