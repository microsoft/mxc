            "type": "string"
          },
          "type": "array"
        },
        "readonlyPaths": {
          "description": "Optional paths granted read-only access.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "readwritePaths": {
          "description": "Optional paths granted read-write access.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "IsolationSession": {
      "additionalProperties": false,
      "description": "IsolationSession settings accepted by lifecycle provisioning.",
      "properties": {
        "appId": {
          "description": "Optional application identifier carried by the sandbox identity.\n\nPackaged applications must use `PFN:<packageFamilyName>`, for example `PFN:Contoso.App_8wekyb3d8bbwe`. Unpackaged applications may pass any string.",
          "type": "string"
