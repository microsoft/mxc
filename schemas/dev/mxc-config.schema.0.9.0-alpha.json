        "cidr": {
          "description": "The IPv4 or IPv6 CIDR this destination matches.",
          "type": "string"
        },
        "except": {
          "description": "Optional CIDRs excluded from this destination.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "cidr"
      ],
      "type": "object"
    },
    "NetworkPort": {
      "additionalProperties": false,
      "description": "A protocol and destination-port selector.",
      "properties": {
        "endPort": {
          "description": "Optional inclusive end of a destination-port range. Requires `port`.",
          "maximum": 65535,
          "minimum": 1.0,
          "type": "integer"
        },
        "port": {
          "description": "Optional destination port. Omission matches every port.",
          "maximum": 65535,
          "minimum": 1.0,
          "type": "integer"
        },
        "protocol": {
          "$ref": "#/definitions/NetworkProtocol",
          "description": "Optional transport protocol. Defaults to `any`."
        }
      },
      "type": "object"
    },
    "NetworkProtocol": {
      "oneOf": [
        {
          "description": "Tcp",
