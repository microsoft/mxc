<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Mxc.Diplomat.Generated\Microsoft.Mxc.Diplomat.Generated.csproj" />
  </ItemGroup>

  <Target Name="RequireGeneratedPrototypeFacade" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('Generated/MxcDiplomatPrototype.g.cs')"
           Text="Run scripts/generate-diplomat-bindings.ps1 before building the public Diplomat prototype." />
  </Target>

</Project>
