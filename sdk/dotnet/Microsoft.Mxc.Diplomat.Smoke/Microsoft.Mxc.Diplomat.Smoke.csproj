<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Mxc.Diplomat.Prototype\Microsoft.Mxc.Diplomat.Prototype.csproj" />
    <None Include="..\..\..\src\target\debug\mxc_ffi.dll"
          Link="mxc_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireNativeLibrary" BeforeTargets="Build">
    <Error Condition="!Exists('..\..\..\src\target\debug\mxc_ffi.dll')"
           Text="Run scripts/generate-diplomat-bindings.ps1 -Smoke to build mxc_ffi before running this project." />
  </Target>

</Project>
