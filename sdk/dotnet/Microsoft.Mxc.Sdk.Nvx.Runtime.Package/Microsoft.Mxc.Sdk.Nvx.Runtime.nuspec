    <file src="buildTransitive\Microsoft.Mxc.Sdk.Nvx.Runtime.targets" target="build" />
    <file src="$repositoryRoot$\LICENSE.md" target="" />
    <file src="$repositoryRoot$\sdk\dotnet\README.md" target="" />
  </files>
</package>
