    <repository type="git" url="https://github.com/microsoft/mxc" />
    <description>Windows x64 NVX MicroVM runtime assets for Microsoft.Mxc.Sdk.</description>
    <tags>mxc sandbox isolation security</tags>
    <dependencies>
      <group targetFramework="net8.0"><dependency id="Microsoft.Mxc.Sdk" version="[$version$]" /></group>
      <group targetFramework="net10.0"><dependency id="Microsoft.Mxc.Sdk" version="[$version$]" /></group>
    </dependencies>
  </metadata>
  <files>
    <file src="$nvxRuntime$\**" target="runtimes\win-x64\aci-edge-sandboxes" />
