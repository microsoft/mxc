<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Mxc.Sdk" Version="$(MxcPackageVersion)" />
  </ItemGroup>

  <Target Name="ValidateMxcPackageVersion" BeforeTargets="Restore;Build">
    <Error Condition="'$(MxcPackageVersion)' == ''"
           Text="MxcPackageVersion is required. Run tests through run.ps1 and provide the built Microsoft.Mxc.Sdk package." />
  </Target>

</Project>
