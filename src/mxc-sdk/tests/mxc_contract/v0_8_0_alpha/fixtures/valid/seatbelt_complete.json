{
  "version": "0.8.0-alpha",
  "containment": "seatbelt",
  "process": {
    "commandLine": "echo seatbelt complete"
  },
  "seatbelt": {
    "profileOverride": "(version 1) (allow default)",
    "guiAccess": true,
    "launchMethod": "open",
    "nestedPty": false,
    "keychainAccess": true,
    "extraMachLookups": [
      "com.apple.SecurityServer",
      "com.apple.coreservices.launchservicesd"
    ]
  }
}