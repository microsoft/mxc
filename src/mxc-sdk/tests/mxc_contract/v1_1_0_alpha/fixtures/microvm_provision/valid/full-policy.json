{
  "version": "1.1.0-alpha",
  "phase": "provision",
  "containment": "microvm",
  "filesystem": {
    "readwritePaths": ["C:\\work"],
    "readonlyPaths": ["C:\\tools"],
    "deniedPaths": ["C:\\work\\secret"]
  },
  "network": {
    "egress": {
      "default": "deny"
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  },
  "runtimeConfig": {
    "networkProxy": "http://127.0.0.1:3128"
  },
  "microvm": {
    "image": "python:3.12-alpine",
    "provision": {
      "memoryMib": 1024
    }
  }
}
