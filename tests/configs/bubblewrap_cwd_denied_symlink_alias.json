{
  "version": "0.8.0-alpha",
  "containerId": "CLI-Bubblewrap-Cwd-DeniedSymlinkAlias",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "echo CWD_DENIED_ALIAS_COMMAND_RAN",
