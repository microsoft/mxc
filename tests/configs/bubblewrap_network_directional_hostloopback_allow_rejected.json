{
  "version": "0.8.0-alpha",
  "containerId": "CLI-Bubblewrap-Network-Directional-HostLoopback-Allow-Rejected",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "echo DIRECTIONAL_HOST_LOOPBACK_ALLOW_SHOULD_NOT_RUN"
  },
  "network": {
    "egress": { "default": "allow" },
    "ingress": { "default": "deny", "hostLoopback": "allow" }
  }
}
