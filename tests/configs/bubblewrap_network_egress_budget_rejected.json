{
  "version": "0.8.0-alpha",
  "containerId": "CLI-Bubblewrap-Egress-Budget-Rejected",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "echo EGRESS_BUDGET_SHOULD_NOT_RUN"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "0.0.0.0/0",
              "except": [
                "1.0.0.1/32",
                "2.0.0.1/32",
                "3.0.0.1/32",
                "4.0.0.1/32",
                "5.0.0.1/32",
                "6.0.0.1/32",
                "7.0.0.1/32",
                "8.0.0.1/32",
                "9.0.0.1/32",
                "10.0.0.1/32",
                "11.0.0.1/32",
                "12.0.0.1/32",
                "13.0.0.1/32",
                "14.0.0.1/32",
                "15.0.0.1/32",
                "16.0.0.1/32",
                "17.0.0.1/32",
                "18.0.0.1/32",
                "19.0.0.1/32",
                "20.0.0.1/32"
              ]
            }
          ]
        }
      ]
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  }
}
