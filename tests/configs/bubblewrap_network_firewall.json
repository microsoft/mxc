{
  "version": "0.6.0-alpha",
  "containerId": "CLI-Bubblewrap-Network-Firewall",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "echo BWRAP_FW_STARTED; wget -qO- --timeout=5 https://api.github.com/zen 2>&1 || echo BWRAP_FW_WGET_DONE"
  },
  "network": {
    "defaultPolicy": "block",
    "enforcementMode": "firewall",
    "allowedHosts": ["api.github.com"],
    "blockedHosts": ["evil.example.com"]
  }
}
