{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-Bubblewrap-Network-Firewall-Hostname-Rejected",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "echo FIREWALL_HOSTNAME_RAN"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "api.github.com"
            }
          ]
        }
      ]
    }
  }
}
