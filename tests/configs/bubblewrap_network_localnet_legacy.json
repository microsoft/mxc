{
  "version": "0.7.0-alpha",
  "containerId": "CLI-Bubblewrap-LocalNet-Legacy",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "bash -c 'set -u; echo SANDBOX_NETNS=$(readlink /proc/self/ns/net); echo LEGACY_LOCALNET_OK'"
  },
  "network": {
    "defaultPolicy": "allow",
    "allowLocalNetwork": false
  }
}
