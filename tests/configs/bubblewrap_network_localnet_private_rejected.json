{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-Bubblewrap-LocalNet-Private-Rejected",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "echo LOCALNET_SHOULD_NOT_RUN"
  },
  "network": {
    "egress": {
      "default": "deny"
    },
    "ingress": {
      "default": "allow",
      "hostLoopback": "allow"
    }
  }
}
