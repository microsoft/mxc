{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "CLI-Bubblewrap-Provider-Loss",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "echo PROVIDER_LOSS_STARTED; /bin/sleep 985",
    "timeout": 90000
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [{ "to": [{ "cidr": "203.0.113.0/24" }] }]
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  }
}
