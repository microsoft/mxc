{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "CLI-Bubblewrap-Teardown-Timeout",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "echo TEARDOWN_STARTED; (/bin/sleep 987; echo TEARDOWN_DESCENDANT_LEAKED) & wait",
    "timeout": 1500
  }
}
