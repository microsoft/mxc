{
  "$schema": "../../schemas/dev/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-bubblewrap-Env-09-inherit",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "echo \"PATH=[$PATH]\"; echo \"HOME=[$HOME]\"; echo \"TERM=[$TERM]\"; echo \"FOO=[$FOO]\"; echo ENV_PROBE_DONE",
    "timeout": 20000,
    "env": [
      "FOO=bar",
      "TERM=dumb"
    ],
    "inheritDefaultEnv": true
  }
}
