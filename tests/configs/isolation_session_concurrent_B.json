{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "isolation-session-concurrent-B",
  "containment": "isolation_session",
  "process": {
    "commandLine": "echo B-started & set /p GO= & call echo B-released-%GO%",
    "timeout": 180000
  },
  "network": {
    "egress": {
      "default": "allow"
    },
    "ingress": {
      "default": "allow",
      "hostLoopback": "allow"
    }
  }
}
