{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "isolation-session-configid-rejected",
  "containment": "isolation_session",
  "process": {
    "commandLine": "echo USERNAME=%USERNAME% & echo MYVAR=%MYVAR% & echo CWD=%CD% & whoami",
    "cwd": "C:\\mxc_workdir_test",
    "env": [
      "MYVAR=IsolationSessionTest"
    ],
    "timeout": 30000
  },
  "isolationSession": {
    "configurationId": "medium"
  },
  "network": {
    "egress": {
      "default": "allow"
    },
    "ingress": {
      "default": "allow",
      "hostLoopback": "allow"
    }
  }
}
