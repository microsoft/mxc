{
  "version": "0.9.0-alpha",
  "containerId": "isolation-session-hello",
  "containment": "isolation_session",
  "network": {
    "egress": { "default": "allow" },
    "ingress": { "default": "allow", "hostLoopback": "allow" }
  },
  "process": {
    "commandLine": "echo USERNAME=%USERNAME% & echo MYVAR=%MYVAR% & echo CWD=%CD% & whoami",
    "cwd": "C:\\mxc_workdir_test",
    "env": ["MYVAR=IsolationSessionTest"],
    "timeout": 30000
  }
}
