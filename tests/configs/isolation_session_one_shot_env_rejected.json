{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "isolation-session-one-shot-env-rejected",
  "containment": "isolation_session",
  "process": {
    "commandLine": "echo unreachable",
    "env": ["FOO=bar"],
    "timeout": 30000
  },
  "network": {
    "egress": {
      "default": "allow"
    },
    "ingress": {
      "default": "allow",
      "hostLoopback": "allow"
    }
  }
}
