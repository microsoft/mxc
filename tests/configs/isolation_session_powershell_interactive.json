{
  "version": "0.9.0-alpha",
  "containerId": "isolation-session-powershell-interactive",
  "containment": "isolation_session",
  "process": {
    "commandLine": "powershell.exe -NoLogo",
    "timeout": 0
  },
  "network": {
    "egress": {
      "default": "allow"
    },
    "ingress": {
      "default": "allow",
      "hostLoopback": "allow"
    }
  }
}
