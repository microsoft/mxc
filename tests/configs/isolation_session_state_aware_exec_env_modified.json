{
    "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
    "version": "1.0.0",
    "phase": "exec",
    "sandboxId": "{{SANDBOX_ID}}",
    "process": {
        "commandLine": "echo %MY_SA_ENV%",
        "env": ["MY_SA_ENV=modified-value"],
        "inheritDefaultEnv": true,
        "timeout": 30000
    }
}
