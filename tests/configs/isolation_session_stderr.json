{
  "version": "0.6.0-alpha",
  "containerId": "isolation-session-stderr",
  "containment": "isolation_session",
  "network": {
    "defaultPolicy": "allow",
    "allowLocalNetwork": true
  },
  "process": {
    "commandLine": "echo MARKER_STDOUT & echo MARKER_STDERR 1>&2",
    "timeout": 30000
  }
}
