{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containment": "isolation_session",
  "process": {
    "commandLine": "cmd.exe /d /v:on /c \"set /p line= & if \"!line!\"==\"MXC_STDIN_ROUTING\" (exit /b 42) else (exit /b 43)\"",
    "timeout": 30000
  },
  "network": {
    "egress": {
      "default": "allow"
    },
    "ingress": {
      "default": "allow",
      "hostLoopback": "allow"
    }
  }
}
