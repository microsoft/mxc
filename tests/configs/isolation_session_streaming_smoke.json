{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "isolation-session-streaming-smoke",
  "containment": "isolation_session",
  "process": {
    "commandLine": "echo line_1 & ping -n 6 127.0.0.1 >nul & echo line_2 & ping -n 6 127.0.0.1 >nul & echo line_3",
    "timeout": 30000
  },
  "network": {
    "egress": {
      "default": "allow"
    },
    "ingress": {
      "default": "allow",
      "hostLoopback": "allow"
    }
  }
}
