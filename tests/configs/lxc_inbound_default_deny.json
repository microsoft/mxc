{
  "version": "0.7.0-alpha",
  "containerId": "CLI-LXC-Inbound-Deny",
  "containment": "lxc",
  "process": {
    "commandLine": "echo inbound-default-deny-ok"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "defaultPolicy": "allow",
    "enforcementMode": "firewall"
  }
}
