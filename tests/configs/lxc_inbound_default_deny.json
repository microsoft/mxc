{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-Inbound-Deny",
  "containment": "lxc",
  "process": {
    "commandLine": "echo inbound-default-deny-ok"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "allow"
    }
  }
}
