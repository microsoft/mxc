{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "CLI-LXC-V08-Permissive-Ingress",
  "containment": "lxc",
  "process": {
    "commandLine": "echo this-should-never-run"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "ingress": {
      "default": "allow",
      "hostLoopback": "deny"
    }
  }
}
