{
  "version": "0.8.0-alpha",
  "containerId": "CLI-LXC-Inbound-Permissive",
  "containment": "lxc",
  "process": {
    "commandLine": "echo this-should-never-run"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "defaultPolicy": "allow",
    "enforcementMode": "firewall",
    "allowLocalNetwork": true
  }
}
