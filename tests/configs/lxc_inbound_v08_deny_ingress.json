{
  "version": "0.8.0-alpha",
  "containerId": "CLI-LXC-Inbound-V08-Deny",
  "containment": "lxc",
  "process": {
    "commandLine": "echo MXC_WORKLOAD_RAN"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "allow"
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  }
}
