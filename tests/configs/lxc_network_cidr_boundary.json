{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-Network-CIDR-Boundary",
  "containment": "lxc",
  "process": {
    "commandLine": "true"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "0.0.0.0/0"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "::/0"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "140.82.112.5"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "140.82.112.5/20"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "140.82.112.5/32"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2606:50c0:8000::153/32"
            }
          ]
        }
      ],
      "deny": [
        {
          "to": [
            {
              "cidr": "198.51.100.42"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "198.51.100.42/32"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2001:db8::5"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2001:db8::5/128"
            }
          ]
        }
      ]
    }
  }
}
