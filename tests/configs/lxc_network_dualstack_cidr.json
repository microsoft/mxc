{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-Network-Dualstack-CIDR",
  "containment": "lxc",
  "process": {
    "commandLine": "wget -qO- https://dns.google/"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "127.0.0.1/32"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "1.1.1.1/32"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2606:4700:4700::1111/128"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "8.8.8.8/32"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2001:4860:4860::8888/128"
            }
          ]
        }
      ],
      "deny": [
        {
          "to": [
            {
              "cidr": "10.0.0.0/8"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2001:db8::/32"
            }
          ]
        }
      ]
    }
  }
}
