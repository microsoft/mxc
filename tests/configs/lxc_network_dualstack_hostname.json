{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-Network-Dualstack-Hostname",
  "containment": "lxc",
  "process": {
    "commandLine": "wget -qO- https://dns.google/"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "localhost"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "dns.google"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "one.one.one.one"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "8.8.8.8"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2001:4860:4860::8888"
            }
          ]
        }
      ],
      "deny": [
        {
          "to": [
            {
              "cidr": "10.0.0.0/8"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2001:db8::/32"
            }
          ]
        }
      ]
    }
  }
}
