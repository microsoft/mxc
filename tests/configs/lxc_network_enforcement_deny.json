{
  "version": "0.7.0-alpha",
  "containerId": "CLI-LXC-Net-Deny",
  "containment": "lxc",
  "process": {
    "commandLine": "sh -c \"wget -qO- --timeout=8 http://198.51.100.2:443/ >/dev/null 2>&1 && echo MXC_NET_ALLOWED || echo MXC_NET_BLOCKED\""
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "defaultPolicy": "block",
    "enforcementMode": "firewall",
    "allowedHosts": [],
    "blockedHosts": []
  }
}