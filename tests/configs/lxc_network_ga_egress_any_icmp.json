{
  "version": "0.8.0-alpha",
  "containerId": "CLI-LXC-GA-Egress-Any-Icmp",
  "containment": "lxc",
  "process": {
    "commandLine": "sh -c \"timeout 8 ping -c 1 -W 5 203.0.113.2 >/dev/null 2>&1 && echo MXC_NET_ALLOWED || echo MXC_NET_BLOCKED\""
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [{ "cidr": "203.0.113.0/24" }],
          "ports": [{ "protocol": "any" }]
        }
      ]
    }
  }
}
