{
  "version": "0.8.0-alpha",
  "containerId": "CLI-LXC-GA-Egress-Deny-Rule",
  "containment": "lxc",
  "process": {
    "commandLine": "sh -c \"timeout 8 nslookup -type=a example.com 203.0.113.10 >/dev/null 2>&1 && echo MXC_NET_ALLOWED || echo MXC_NET_BLOCKED\""
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "allow",
      "deny": [
        {
          "to": [{ "cidr": "203.0.113.10/32" }],
          "ports": [{ "protocol": "udp", "port": 53 }]
        }
      ]
    }
  }
}
