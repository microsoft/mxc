{
  "version": "0.8.0-alpha",
  "containerId": "CLI-LXC-GA-Egress-Except-Shadow",
  "containment": "lxc",
  "process": {
    "commandLine": "sh -c \"wget -qO- --timeout=10 http://203.0.113.2:443/ >/dev/null 2>&1 && echo MXC_NET_ALLOWED || echo MXC_NET_BLOCKED\""
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "allow",
      "deny": [
        {
          "to": [{ "cidr": "203.0.113.0/24", "except": ["203.0.113.2/32"] }],
          "ports": [{ "protocol": "tcp", "port": 443 }]
        },
        {
          "to": [{ "cidr": "203.0.113.2/32" }],
          "ports": [{ "protocol": "tcp", "port": 443 }]
        }
      ]
    }
  }
}
