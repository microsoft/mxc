{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-Network-Invalid-CIDR",
  "containment": "lxc",
  "process": {
    "commandLine": "true"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "140.82.112.0/33"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2606:50c0::/129"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "140.82.112.0/not-a-prefix"
            }
          ]
        }
      ]
    }
  }
}
