{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-Network-IPv6-CIDR",
  "containment": "lxc",
  "process": {
    "commandLine": "true"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "140.82.112.0/20"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2606:50c0::/32"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2606:50c0:8000::153"
            }
          ]
        }
      ],
      "deny": [
        {
          "to": [
            {
              "cidr": "10.0.0.0/8"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "2001:db8::/32"
            }
          ]
        },
        {
          "to": [
            {
              "cidr": "fe80::1"
            }
          ]
        }
      ]
    }
  }
}
