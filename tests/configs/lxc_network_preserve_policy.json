{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-Net-Preserve",
  "containment": "lxc",
  "process": {
    "commandLine": "sh -c \"echo MXC_PRESERVE_RAN\""
  },
  "lifecycle": {
    "destroyOnExit": false,
    "preservePolicy": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "140.82.112.0/20"
            }
          ]
        }
      ]
    }
  }
}
