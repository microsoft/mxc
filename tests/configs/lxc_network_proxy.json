{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-Network-Proxy",
  "containment": "lxc",
  "process": {
    "commandLine": "wget -qO- http://mxc.invalid/"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": { "default": "deny" }
  },
  "runtimeConfig": {
    "networkProxy": "http://127.0.0.1:3128"
  }
}
