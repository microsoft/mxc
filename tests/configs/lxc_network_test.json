{
  "version": "0.6.0-alpha",
  "containerId": "CLI-LXC-Network-Test",
  "containment": "lxc",
  "process": {
    "commandLine": "wget -qO- --timeout=10 http://198.51.100.18:443/"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "defaultPolicy": "block",
    "enforcementMode": "firewall",
    "allowedHosts": ["allowed.nettest.mxc.test"],
    "blockedHosts": ["blocked.nettest.mxc.test"]
  }
}