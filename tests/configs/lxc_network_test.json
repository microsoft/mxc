{
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-Network-Test",
  "containment": "lxc",
  "process": {
    "commandLine": "wget -qO- --timeout=10 http://198.51.100.18:443/"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "allowed.nettest.mxc.test"
            }
          ]
        }
      ],
      "deny": [
        {
          "to": [
            {
              "cidr": "blocked.nettest.mxc.test"
            }
          ]
        }
      ]
    }
  }
}
