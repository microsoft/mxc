{
  "version": "0.7.0-alpha",
  "containerId": "CLI-LXC-V07-DNS-Exemption",
  "containment": "lxc",
  "process": {
    "commandLine": "sh -c \"timeout 8 nslookup -type=a example.com 198.51.100.26 >/dev/null 2>&1 && echo MXC_NET_ALLOWED || echo MXC_NET_BLOCKED\""
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.23"
  },
  "network": {
    "defaultPolicy": "block",
    "enforcementMode": "firewall"
  }
}
