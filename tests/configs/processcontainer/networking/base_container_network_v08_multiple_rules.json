{
  "$schema": "../../../../schemas/dev/mxc-config.schema.0.8.0-dev.json",
  "version": "0.8.0-dev",
  "containerId": "CLI-BaseContainer-v08-Multiple-Rules",
  "containment": "processcontainer",
  "process": {
    "commandLine": "powershell.exe -NoProfile -NonInteractive -Command \"$client = [Net.Sockets.TcpClient]::new(); try { $connected = $client.ConnectAsync('1.1.1.1', 443).Wait(5000) } catch { $connected = $false } finally { $client.Dispose() }; if ($connected) { Write-Output 'OK:multiple_network_rules'; exit 0 }; Write-Output 'FAIL:multiple_network_rules_blocked'; exit 1\"",
    "timeout": 15000
  },
  "filesystem": {
    "readonlyPaths": ["C:\\Windows"]
  },
  "ui": {
    "disable": false
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {"cidr": "1.1.1.0/24", "except": ["1.1.1.2/32", "1.1.1.3/32"]},
            {"cidr": "2606:4700:4700::1111/128"}
          ],
          "ports": [
            {"protocol": "tcp", "port": 443},
            {"protocol": "udp", "port": 53}
          ]
        },
        {
          "to": [{"cidr": "8.8.8.8/32"}],
          "ports": [{"protocol": "icmp"}]
        }
      ],
      "deny": [
        {
          "to": [{"cidr": "1.1.1.2/32"}],
          "ports": [{"protocol": "tcp", "port": 443}]
        },
        {
          "to": [{"cidr": "203.0.113.0/24"}],
          "ports": [{"protocol": "any"}]
        }
      ]
    }
  }
}
