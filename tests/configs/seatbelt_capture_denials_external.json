{
    "$schema": "../../schemas/dev/mxc-config.schema.1.1.0-alpha.json",
    "version": "1.1.0-alpha",
    "containment": "seatbelt",
    "process": {
        "commandLine": "/usr/bin/python3 -c 'import socket\ns = socket.socket(); s.settimeout(5)\nprint(\"EXTERNAL_OK\" if s.connect_ex((\"1.1.1.1\", 443)) == 0 else \"EXTERNAL_BLOCKED\")'",
        "timeout": 30000
    },
    "filesystem": { "readonlyPaths": ["{{DEVDIR}}"] },
    "network": { "egress": { "default": "deny" } },
    "seatbelt": {
        "captureDenials": {
            "mode": "block",
            "outputPath": "{{OUTPUT}}"
        }
    }
}
