{
    "$schema": "../../schemas/dev/mxc-config.schema.1.1.0-alpha.json",
    "version": "1.1.0-alpha",
    "containment": "seatbelt",
    "process": {
        "commandLine": "/usr/bin/osascript -l JavaScript {{TESTDIR}}/app/window.js",
        "timeout": 30000
    },
    "filesystem": {
        "readonlyPaths": [
            "{{TESTDIR}}/app"
        ]
    },
    "ui": {
        "disable": false
    },
    "seatbelt": {
        "guiAccess": true,
        "captureDenials": {
            "outputPath": "{{OUTPUT}}"
        }
    }
}
