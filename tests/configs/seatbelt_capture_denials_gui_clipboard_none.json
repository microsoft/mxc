{
    "$schema": "../../schemas/dev/mxc-config.schema.1.1.0-alpha.json",
    "version": "1.1.0-alpha",
    "containment": "seatbelt",
    "process": {
        "commandLine": "pbpaste > /dev/null 2>&1 && echo CLIPBOARD_OK || echo CLIPBOARD_BLOCKED",
        "timeout": 20000
    },
    "ui": {
        "disable": false,
        "clipboard": "none"
    },
    "seatbelt": {
        "guiAccess": true,
        "captureDenials": {
            "outputPath": "{{OUTPUT}}"
        }
    }
}
