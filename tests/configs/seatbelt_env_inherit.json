{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "CLI-seatbelt-Env-inherit",
  "containment": "seatbelt",
  "process": {
    "commandLine": "echo \"PATH=[$PATH]\"; echo \"HOME=[$HOME]\"; echo \"TERM=[$TERM]\"; echo \"FOO=[$FOO]\"; echo \"LEAK=[$MXC_LEAK_PROBE]\"; echo ENV_PROBE_DONE",
    "cwd": "/private/tmp",
    "timeout": 20000,
    "env": [
      "FOO=bar",
      "TERM=vt100"
    ],
    "inheritDefaultEnv": true
  },
  "filesystem": {
    "readwritePaths": [
      "/private/tmp"
    ]
  }
}
