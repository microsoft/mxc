{
    "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
    "version": "1.0.0",
    "containment": "seatbelt",
    "process": {
        "commandLine": "cat {{TESTDIR}}/denied/secret.txt && echo FS_DENIED_READ_SUCCEEDED; echo FS_PROBE_DONE",
        "timeout": 10000
