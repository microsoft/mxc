{
    "$schema": "../../schemas/dev/mxc-config.schema.1.1.0-alpha.json",
    "version": "1.1.0-alpha",
    "containment": "seatbelt",
    "process": {
        "commandLine": "id -un || true",
        "timeout": 20000
    },
    "ui": {
        "disable": false
    },
    "seatbelt": {
        "guiAccess": true,
        "customMachLookups": {
            "default": "allow",
            "deny": [
                "com.apple.system.opendirectoryd.*"
            ]
        }
    }
}
