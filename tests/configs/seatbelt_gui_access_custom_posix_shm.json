{
    "$schema": "../../schemas/dev/mxc-config.schema.1.1.0-alpha.json",
    "version": "1.1.0-alpha",
    "containment": "seatbelt",
    "process": {
        "commandLine": "/usr/bin/python3 {{TESTDIR}}/shm_probe.py {{SHM}} </dev/null",
        "timeout": 20000
    },
    "filesystem": {
        "readonlyPaths": [
            "{{DEVDIR}}",
            "{{TESTDIR}}"
        ]
    },
    "ui": {
        "disable": false
    },
    "seatbelt": {
        "guiAccess": true,
        "customPosixShm": {
            "default": "deny",
            "read": [
                "{{SHM}}.ro"
            ],
            "readWrite": [
                "{{SHM}}.rw"
            ],
            "own": [
                "{{SHM}}.c.*"
            ],
            "deny": [
                "{{SHM}}.c.no"
            ]
        }
    }
}
