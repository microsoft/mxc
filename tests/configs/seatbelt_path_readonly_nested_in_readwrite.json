{
    "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
    "version": "1.0.0",
    "containment": "seatbelt",
    "process": {
        "commandLine": "cat {{TESTDIR}}/rw/inner/secret.txt && (echo x > {{TESTDIR}}/rw/inner/w.txt && echo PATH_NESTED_RO_WRITE_SUCCEEDED)",
        "timeout": 10000
    },
    "filesystem": {
        "readwritePaths": ["{{TESTDIR}}/rw"],
        "readonlyPaths": ["{{TESTDIR}}/rw/inner"]
    }
}
