{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containment": "seatbelt",
  "process": {
    "commandLine": "/usr/bin/python3 -c 'import socket\ns=socket.socket(); s.settimeout(5)\nprint(\"DIRECT_OK\" if s.connect_ex((\"1.1.1.1\",443))==0 else \"DIRECT_BLOCKED\")'",
    "timeout": 30000
  },
  "network": {
    "egress": {
      "default": "deny"
    }
  },
  "filesystem": {
    "readonlyPaths": [
      "{{DEVDIR}}"
    ],
    "readwritePaths": [
      "/private/tmp"
    ]
  },
  "runtimeConfig": {
    "networkProxy": "http://127.0.0.1:{{PROXY_PORT}}"
  }
}
