{
  "$schema": "../../schemas/stable/mxc-config.schema.0.9.0-alpha.json",
  "version": "0.9.0-alpha",
  "containment": "seatbelt",
  "process": {
    "commandLine": "curl -fsS --max-time 20 http://mxc-blocked.invalid/ > /dev/null 2>&1 && echo DENIED_HOST_REACHED || echo DENIED_HOST_BLOCKED",
    "timeout": 30000
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "mxc-test.invalid"
            }
          ]
        }
      ]
    }
  },
  "runtimeConfig": {
    "networkProxy": "http://127.0.0.1:8080"
  }
}
