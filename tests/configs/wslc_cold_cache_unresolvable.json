{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "_comment": "Cold-cache failure coverage: an image reference no registry resolves, under a storagePath the runner purges first. Pins the non-retryable classification and that the message names a way forward.",
  "version": "1.0.0",
  "containerId": "wslc-cold-cache-unresolvable",
  "containment": "wslc",
  "process": {
    "commandLine": "echo SHOULD_NOT_RUN"
  },
  "network": {
    "egress": { "default": "allow" },
    "ingress": { "default": "allow", "hostLoopback": "allow" }
  },
  "wslc": {
    "image": "library/mxc-no-such-image-should-not-resolve:latest",
    "storagePath": "C:\\mxc_wslc_cold_cache_test"
  }
}
