{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "wslc-network-egress-network-proxy-rejected",
  "containment": "wslc",
  "process": { "commandLine": "echo WSLC_EGRESS_RULES_SHOULD_NOT_RUN" },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [{ "to": [{ "cidr": "1.1.1.1/32" }], "ports": [{ "port": 443, "protocol": "tcp" }] }]
    },
    "ingress": { "default": "deny", "hostLoopback": "deny" }
  },
  "runtimeConfig": { "networkProxy": "http://127.0.0.1:8888" },
  "wslc": { "image": "alpine:latest" }
}
