{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "wslc-network-egress-port-mappings-rejected",
  "containment": "wslc",
  "process": { "commandLine": "echo WSLC_EGRESS_RULES_SHOULD_NOT_RUN" },
  "network": {
    "egress": { "default": "allow", "deny": [{ "to": [{ "cidr": "10.0.0.0/8" }] }] },
    "ingress": { "default": "allow", "hostLoopback": "deny" }
  },
  "wslc": {
    "image": "alpine:latest",
    "portMappings": [{ "windowsPort": 18080, "containerPort": 8080, "protocol": "tcp" }]
  }
}
