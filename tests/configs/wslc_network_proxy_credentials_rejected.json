{
  "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
  "version": "1.0.0",
  "containerId": "wslc-network-proxy-credentials-rejected",
  "containment": "wslc",
  "process": {
    "commandLine": "echo WSLC_PROXY_CREDENTIALS_SHOULD_NOT_RUN",
    "env": ["MXC_PROBE=1"]
  },
  "network": {
    "egress": { "default": "allow" },
    "ingress": { "default": "allow", "hostLoopback": "allow" }
  },
  "runtimeConfig": {
    "networkProxy": "http://proxyuser:s3cr3t@127.0.0.1:8888"
  },
  "wslc": {
    "image": "alpine:latest"
  }
}
