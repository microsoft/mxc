{
    "version": "0.9.0-alpha",
    "phase": "exec",
    "sandboxId": "{{SANDBOX_ID}}",
    "process": {
        "commandLine": "echo \"HOSTCOUNT=[$(env | grep -c '^HOSTNAME=')]\"; echo \"MY_SA_VAR=[$MY_SA_VAR]\"",
        "env": ["MY_SA_VAR=layered"],
        "inheritDefaultEnv": true,
        "timeout": 30000
    }
}
