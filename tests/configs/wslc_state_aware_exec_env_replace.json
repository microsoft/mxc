{
    "$schema": "../../schemas/stable/mxc-config.schema.1.0.0.json",
    "version": "1.0.0",
    "phase": "exec",
    "sandboxId": "{{SANDBOX_ID}}",
    "process": {
        "commandLine": "echo \"HOSTCOUNT=[$(env | grep -c '^HOSTNAME=')]\"; echo \"MY_SA_VAR=[$MY_SA_VAR]\"",
        "env": ["MY_SA_VAR=replaced"],
        "timeout": 30000
    }
}
