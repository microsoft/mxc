{
    "version": "0.9.0-alpha",
    "phase": "provision",
    "containment": "wslc",
    "network": {
        "egress": { "default": "allow" },
        "ingress": { "default": "allow", "hostLoopback": "allow" }
    },
    "experimental": {
        "wslc": {
            "provision": {
                "image": "alpine:latest",
                "portMappings": [
                    { "windowsPort": 18080, "containerPort": 80, "protocol": "tcp" }
                ]
            }
        }
    }
}
