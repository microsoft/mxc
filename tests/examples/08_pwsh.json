{
  "version": "0.6.0-alpha",
  "containerId": "CLI-Pwsh",
  "containment": "processcontainer",
  "process": {
    "commandLine": "pwsh.exe -nop -nol -c \"Set-PSReadLineOption -HistorySaveStyle SaveNothing; Set-Location c:\\temp\"; Get-Location"
  },
  "filesystem": {
    "readonlyPaths": [
      "C:\\Program Files\\PowerShell\\7"
    ],
    "readwritePaths": [
      "C:\\temp"
    ]
  }
}