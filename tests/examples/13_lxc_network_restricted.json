{
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-NetworkRestricted",
  "containment": "lxc",
  "process": {
    "commandLine": "wget -qO- https://api.github.com/zen || echo 'Network blocked as expected'"
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.20"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "api.github.com"
            }
          ]
        }
      ]
    }
  }
}
