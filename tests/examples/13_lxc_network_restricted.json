{
  "version": "0.9.0-alpha",
  "containerId": "CLI-LXC-NetworkRestricted",
  "containment": "lxc",
  "process": {
    "commandLine": "sh -c \"nc -z -w 5 140.82.114.6 443 && echo 'Allowed destination reachable' || { echo 'Allowed destination unreachable'; exit 1; }\""
  },
  "lifecycle": {
    "destroyOnExit": true
  },
  "lxc": {
    "distribution": "alpine",
    "release": "3.20"
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            {
              "cidr": "140.82.114.6/32"
            }
          ],
          "ports": [{ "protocol": "tcp", "port": 443 }]
        }
      ]
    }
  }
}
