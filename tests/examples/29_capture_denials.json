{
  "$schema": "../../schemas/stable/mxc-config.schema.0.8.0-alpha.json",
  "version": "0.8.0-alpha",
  "containerId": "CLI-CaptureDenials",
  "containment": "processcontainer",
  "process": {
    "commandLine": "python -c \"print('Capture-denials demo: ungranted access attempts are recorded to a JSON denials file')\""
  },
  "processContainer": {
    "capabilities": ["internetClient"],
    "captureDenials": { "mode": "block" }
  }
}
