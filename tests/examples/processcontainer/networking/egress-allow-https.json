{
  "$schema": "../../../../schemas/dev/mxc-config.schema.0.8.0-dev.json",
  "version": "0.8.0-dev",
  "containerId": "CLI-ProcessContainer-Egress-Https",
  "containment": "processcontainer",
  "process": {
    "commandLine": "powershell.exe -NoProfile -NonInteractive -Command \"$client = [Net.Sockets.TcpClient]::new(); try { $client.Connect('1.1.1.1', 443); Write-Output 'HTTPS endpoint reachable' } finally { $client.Dispose() }\"",
    "timeout": 15000
  },
  "filesystem": {
    "readonlyPaths": ["C:\\Windows"]
  },
  "ui": {
    "disable": false
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [{"cidr": "1.1.1.1/32"}],
          "ports": [{"protocol": "tcp", "port": 443}]
        }
      ]
    },
    "ingress": {
      "hostLoopback": "deny"
    }
  }
}
