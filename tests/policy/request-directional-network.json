{
  "policy": {
    "network": {
      "egress": {
        "default": "deny",
        "allow": [
          {
            "to": [
              {
                "cidr": "10.20.0.0/16",
                "except": ["10.20.30.0/24"]
              }
            ],
            "ports": [
              {
                "protocol": "tcp",
                "port": 443,
                "endPort": 444
              }
            ]
          }
        ]
      },
      "ingress": {
        "default": "deny",
        "hostLoopback": "deny"
      }
    }
  },
  "command": "echo network",
  "containment": {
    "type": "process"
  }
}
