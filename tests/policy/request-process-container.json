{
  "version": "0.8.0-alpha",
  "containerId": "golden-process-container",
  "lifecycle": {
    "destroyOnExit": true,
    "preservePolicy": false
  },
  "process": {
    "commandLine": "echo parity",
    "timeout": 30000,
    "cwd": "C:\\work",
    "env": ["PARITY=true"]
  },
  "filesystem": {
    "readwritePaths": ["C:\\work"],
    "readonlyPaths": ["C:\\input"],
    "deniedPaths": ["C:\\secret"]
  },
  "ui": {
    "disable": true,
    "clipboard": "read",
    "injection": false
  },
  "network": {
    "egress": {
      "default": "deny"
    },
    "ingress": {
      "default": "allow",
      "hostLoopback": "deny"
    }
  },
  "runtimeConfig": {
    "networkProxy": "http://127.0.0.1:8080"
  },
  "containment": "processcontainer",
  "processContainer": {
    "leastPrivilege": true,
    "capabilities": [
      "internetClient",
      "privateNetworkClientServer"
    ],
    "ui": {
      "isolation": "handles",
      "desktopSystemControl": false,
      "systemSettings": "parameters",
      "ime": true
    },
    "network": {
      "allowedProxyPeer": "Contoso.App_123"
    },
    "captureDenials": {
      "mode": "block",
      "outputPath": "C:\\denials.json",
      "retainEtl": true
    }
  }
}
