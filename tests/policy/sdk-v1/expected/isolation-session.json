{
  "version": "1.0.0",
  "containerId": "golden-isolation-session",
  "containment": "isolation_session",
  "lifecycle": {
    "destroyOnExit": true,
    "preservePolicy": false
  },
  "process": {
    "commandLine": "echo golden",
    "timeout": 0
  },
  "filesystem": {
    "readwritePaths": [],
    "readonlyPaths": [],
    "deniedPaths": []
  },
  "network": {
    "egress": {
      "default": "allow"
    },
    "ingress": {
      "default": "allow",
      "hostLoopback": "allow"
    }
  }
}
