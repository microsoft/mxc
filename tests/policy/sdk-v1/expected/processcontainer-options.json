{
  "version": "1.0.0",
  "containerId": "golden-processcontainer-options",
  "containment": "processcontainer",
  "lifecycle": {
    "destroyOnExit": true,
    "preservePolicy": false
  },
  "process": {
    "commandLine": "echo golden",
    "timeout": 0
  },
  "filesystem": {
    "readwritePaths": [],
    "readonlyPaths": [],
    "deniedPaths": []
  },
  "processContainer": {
    "leastPrivilege": true,
    "learningMode": true,
    "capabilities": [
      "registryRead"
    ]
  }
}
